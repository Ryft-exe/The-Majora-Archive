{
  "name": "majora-archive",
  "productName": "Majora Archive",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Majora Archive — a Termina-themed Zelda launcher for open-source recomps and emulators. Ships no game data.",
  "license": "GPL-3.0-or-later",
  "author": "RYFT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 5273 --strictPort",
    "dev:desktop": "concurrently -k -s first \"vite --port 5273 --strictPort\" \"wait-on tcp:127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .\"",
    "build": "vite build",
    "pack": "bun run build && electron-builder --win --dir",
    "dist": "bun run typecheck && bun run build && electron-builder --win nsis",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "covers": "bun scripts/fetch-covers.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.majoraarchive.launcher",
    "productName": "Majora Archive",
    "copyright": "Developed by RYFT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/assets/**",
      "**/node_modules/7zip-bin/**"
    ],
    "npmRebuild": false,
    "artifactName": "Majora-Archive-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Majora Archive",
      "uninstallDisplayName": "Majora Archive",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
